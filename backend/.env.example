NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/customer_feedback
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/customer_feedback
MONGO_URI=mongodb://localhost:27017/customer_feedback

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── App URL (used in email deep links) ────────────────────────────────────────
APP_URL=http://localhost:5173

# ── Cloudinary (Image Uploads) ────────────────────────────────────────────────
# Register at https://cloudinary.com and copy from the Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Resend (Transactional Email) ──────────────────────────────────────────────
# Register at https://resend.com and generate an API key
# Set EMAIL_FROM to onboarding@resend.dev for sandbox testing,
# or to your verified domain address for production.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Roadmap Portal <onboarding@resend.dev>
